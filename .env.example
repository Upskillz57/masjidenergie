NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_VIDEO_URL=

# Formulaire « Demander une étude » (envoi via Resend). Ne jamais mettre la vraie clé ici :
# la renseigner dans Vercel et dans .env.local (ignoré par git).
RESEND_API_KEY=
# Expéditeur affiché dans l'e-mail reçu (adresse du domaine vérifié dans Resend).
STUDY_REQUEST_FROM="Masjid Energie <etude@masjidenergie.fr>"
# Boîte(s) qui reçoivent les demandes, séparées par des virgules.
STUDY_REQUEST_TO=

# Supabase (espace admin + comptes mosquées). Projet → Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clé secrète : serveur uniquement, jamais dans le navigateur ni sur GitHub.
SUPABASE_SECRET_KEY=
